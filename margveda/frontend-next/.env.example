# ── CareerBrownie Frontend Environment Variables ───────────────────────────
# Copy this file to .env.local for local development
# Set these in Vercel Dashboard → Settings → Environment Variables for production

# Django backend URL (no trailing slash)
# Local:      http://localhost:8000/api/v1
# Production: https://<your-railway-app>.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Frontend base URL (used for canonical links / redirects)
# Local:      http://localhost:3000
# Production: https://careerbrownie.com  (or your Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (optional — for social login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
