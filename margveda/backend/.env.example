PROJECT_NAME=MargVedA API
VERSION=1.0.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# SQLite for local dev; switch to PostgreSQL for production
DATABASE_URL=sqlite:///./margveda.db
# DATABASE_URL=postgresql+psycopg2://margveda:margveda_password@localhost:5432/margveda

AI_SERVICE_URL=http://127.0.0.1:9000

# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

LOG_LEVEL=INFO

BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
