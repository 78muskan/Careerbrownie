# ── Copy this to .env.prod and fill in your values ──────────────────────────
# Used by docker-compose.prod.yml

DOMAIN=careerbrownie.com

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

POSTGRES_DB=careerbrownie
POSTGRES_USER=careerbrownie
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Email (use Gmail App Password or any SMTP provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=careerbrownie@gmail.com
EMAIL_HOST_PASSWORD=Muskan@123
DEFAULT_FROM_EMAIL=Career Brownie <@careerbrownie.com>

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (optional — leave blank to disable payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Service auth key (shared between Django and AI service)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=REPLACE_WITH_INTERNAL_SECRET

# n8n encryption key
N8N_ENCRYPTION_KEY=REPLACE_WITH_N8N_SECRET

# LLM — Qwen2.5:7b via Ollama (self-hosted, no API cost)
# Fallback only if Ollama is down
ANTHROPIC_API_KEY=
