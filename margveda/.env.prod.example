# ── Copy this to .env.prod and fill in your values ──────────────────────────
# Used by docker-compose.prod.yml

DOMAIN=yourdomain.com

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

POSTGRES_DB=margveda
POSTGRES_USER=margveda
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Email (use Gmail App Password or any SMTP provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=MargVedA <hello@yourdomain.com>

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (optional — leave blank to disable payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
