# ── CareerBrownie Backend Environment Variables ────────────────────────────
# Copy this file to .env for LOCAL development
# Set ALL of these in Railway Dashboard → Variables for PRODUCTION

# ── Core Django ──────────────────────────────────────────────────────────────
SECRET_KEY=your-long-random-secret-key-here-min-50-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# Leave blank for local SQLite.
# Railway: copy from Dashboard → PostgreSQL service → Connect tab.
DATABASE_URL=

# ── AI / Claude ──────────────────────────────────────────────────────────────
# Get from console.anthropic.com → API Keys
# Cost: ~$1 per 1000 chat messages (Claude Haiku)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL=False

# ── Frontend URL (used in email links) ───────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Career Brownie <hello@careerbrownie.com>
ADMIN_EMAIL=admin@careerbrownie.com

# ── Razorpay Payments (optional) ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Redis / Celery (optional) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS S3 (optional — for media file storage) ───────────────────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=careerbrownie-media
AWS_S3_REGION_NAME=ap-south-1
AWS_CLOUDFRONT_DOMAIN=
