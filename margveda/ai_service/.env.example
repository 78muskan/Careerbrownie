ENVIRONMENT=development
LOG_LEVEL=INFO

# Anthropic Claude — required for LLM responses
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# LLM model (claude-haiku-4-5-20251001 is default — fast and cheap)
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Embeddings (all-MiniLM-L6-v2 downloads ~90 MB on first use)
# EMBED_MODEL=all-MiniLM-L6-v2
# EMBED_DEVICE=cpu

# ChromaDB persistence directory (relative to working directory)
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=careerbrownie_knowledge

# Retrieval tuning
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25

# Service-to-service auth (FastAPI backend sends this as X-Internal-Key header)
INTERNAL_API_KEY=change-me-before-production

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
